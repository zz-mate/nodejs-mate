{
  "name": "nodejs-mate",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "format": "pnpm run format:code && pnpm run format:other",
    "format:code": "eslint . --ext .js,.ts --fix",
    "format:other": "prettier --write \"**/*.{json,md,yaml,yml}\"",
    "format:check": "eslint . --ext .js,.ts && prettier --check \"**/*.{json,md}\"",
    "local": "cross-env NODE_ENV=local nodemon --exec ts-node src/main.ts",
    "dev": "cross-env NODE_ENV=development nodemon --exec ts-node src/main.ts",
    "start": "cross-env NODE_ENV=production nodemon --exec ts-node src/main.ts",
    "build:dev": "rimraf dist && cross-env NODE_ENV=development tsc",
    "build:prod": "rimraf dist && cross-env NODE_ENV=production tsc",
    "start:dev": "cross-env NODE_ENV=development node dist/main.js",
    "start:prod": "cross-env NODE_ENV=production node dist/main.js",
    "build:watch": "cross-env NODE_ENV=development tsc-watch --onSuccess \"node dist/main.js\"",
    "prebuild": "tsc --noEmit",
    "start:pm2:prod": "cross-env NODE_ENV=production pm2 start dist/main.js --name mate-production",
    "start:pm2:dev": "cross-env NODE_ENV=development pm2 start dist/main.js --name mate-development"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.24.0",
  "dependencies": {
    "address": "^2.0.3",
    "ali-oss": "^6.23.0",
    "axios": "^1.13.2",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "cross-env": "^10.1.0",
    "dayjs": "^1.11.19",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "fs-extra": "^11.3.3",
    "jimp": "^1.6.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.0.2",
    "mysql2": "^3.6.5",
    "node-schedule": "^2.1.1",
    "openai": "^6.15.0",
    "pinyin": "^4.0.0",
    "pm2": "^6.0.14",
    "qrcode": "^1.5.4",
    "uuid": "8.3.2",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0",
    "xml2js": "^0.6.2"
  },
  "devDependencies": {
    "@types/ali-oss": "^6.23.0",
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/fs-extra": "^11.0.4",
    "@types/jimp": "^0.2.28",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.0.0",
    "@types/mysql": "^2.15.27",
    "@types/node": "^25.0.3",
    "@types/node-schedule": "^2.1.8",
    "@types/qrcode": "^1.5.6",
    "@types/uuid": "8.3.2",
    "@types/winston": "^2.4.4",
    "@types/xml2js": "^0.4.14",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "nodemon": "^3.1.11",
    "prettier": "^3.7.4",
    "rimraf": "^6.1.2",
    "ts-node": "^10.9.2",
    "tsc-watch": "^7.2.0",
    "typescript": "^5.9.3"
  }
}